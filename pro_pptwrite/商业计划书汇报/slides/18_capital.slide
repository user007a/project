<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>40% 股权现金入股金额与资金投向</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 24 }}>
    {/* 左：分期 + 用途柱状 */}
    <Box style={{ flex: 1.2, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '14px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F5C46', marginBottom: 10 }}>实缴分期（降低一次性资金压力）</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 10 }}>
          <Box style={{ flex: 0.6, background: '#0F5C46', borderRadius: 10, padding: 12, alignItems: 'center' }}>
            <Text style={{ color: '#7FE3C0', fontSize: 26, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>60%</Text>
            <Text style={{ color: '#FFFFFF', fontSize: 14, marginTop: 4 }}>股权变更后</Text>
            <Text style={{ color: '#FFFFFF', fontSize: 18, fontWeight: 'bold', marginTop: 2 }}>720 万</Text>
          </Box>
          <FAIcon name='arrow-right' style={{ fill: '#2E9E78', width: 22, height: 22 }} />
          <Box style={{ flex: 0.4, background: '#2E9E78', borderRadius: 10, padding: 12, alignItems: 'center' }}>
            <Text style={{ color: '#FFFFFF', fontSize: 22, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>40%</Text>
            <Text style={{ color: '#FFFFFF', fontSize: 13, marginTop: 4 }}>申报材料递交后</Text>
            <Text style={{ color: '#FFFFFF', fontSize: 16, fontWeight: 'bold', marginTop: 2 }}>480 万</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 15, color: '#3A463F', lineHeight: 1.55 }}>① 股权变更完成后实缴 <Text style={{ fontWeight:'bold',color:'#0F5C46' }}>60% = 720 万元</Text>；② 省级鉴定资质申报材料递交人社厅后实缴剩余 <Text style={{ fontWeight:'bold',color:'#0F5C46' }}>40% = 480 万元</Text>。设立专项资金台账，湖外可全程监督。</Text>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '10px 16px 4px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flex: 1 }}>
        <Chart
          chartType='barChart'
          barDirection='bar'
          grouping='clustered'
          title='1200 万资金专项用途（万元）'
          titleColor='#1C2B24'
          showLegend={false}
          showDataLabels={true}
          dataLabelColor='#0F5C46'
          legendColor='#5C6B63'
          axisColor='#5C6B63'
          colors={['#2E9E78']}
          background='#FFFFFF'
          style={{ width: '100%', height: '100%' }}
          data={[
            ['用途', '金额'],
            ['省级鉴定申报', 420],
            ['线上平台迭代', 300],
            ['市场渠道拓展', 240],
            ['团队/师资扩充', 150],
            ['场地改造/耗材', 90],
          ]}
        />
      </Box>
    </Box>

    {/* 右：巨型数字 + 出资规则 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: 'linear-gradient(135deg,#0A2B4D,#0F5C46)', borderRadius: 14, padding: '20px 24px', alignItems: 'center' }}>
        <Text style={{ color: 'rgba(255,255,255,0.85)', fontSize: 18 }}>湖外 40% 股权对应总出资</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', marginTop: 4 }}>
          <Text style={{ color: '#7FE3C0', fontSize: 96, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif", lineHeight: 1 }}>1200</Text>
          <Text style={{ color: '#FFFFFF', fontSize: 30, fontWeight: 'bold', marginBottom: 12, marginLeft: 6 }}>万元</Text>
        </Box>
        <Text style={{ color: 'rgba(255,255,255,0.8)', fontSize: 15, marginTop: 4 }}>全部为货币现金，场地设备仅台账备案、不抵充任何入股资金</Text>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '18px 22px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flex: 1, justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F5C46', marginBottom: 8 }}>资金监管</Text>
        <Text style={{ fontSize: 16.5, color: '#3A463F', lineHeight: 1.62 }}>资金专项用于多工种省级鉴定资质申报、线上全国平台迭代升级、市场渠道拓展、运营与考评团队扩充、实训耗材储备、场地标准化改造；建立专项台账，湖外可全程查阅、监督使用明细，保障全部用于约定产业发展事项。</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>18 / 27</Text>
    </Box>
  </Box>
</Slide>
