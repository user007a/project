<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>叁竹行业核心突出优势</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'column', gap: 14 }}>
    {/* 第一行 3 卡 */}
    <Box style={{ flexDirection: 'row', gap: 18, height: 196 }}>
      {[
        ['省内头部行业地位', '养老照护培训规模、口碑稳居湖南省内行业前三，在民政、人社、各大康养机构具备高度认可度，品牌壁垒显著。'],
        ['完整自研标准化体系', '长期照护师、养老护理员等九大工种全套课程、教材、实训考评标准全部自主搭建，拥有独家课程无形资产。'],
        ['成熟全国线上平台', '全国线上培训、咨询数字化平台已落地运营，突破地域限制，具备面向全国复制扩张的线上运营能力。'],
      ].map((c, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '18px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
          <FAIcon name='check-circle' style={{ fill: '#2E9E78', width: 30, height: 30 }} />
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46', marginTop: 10 }}>{c[0]}</Text>
          <Text style={{ fontSize: 15.5, color: '#3A463F', lineHeight: 1.5, marginTop: 6 }}>{c[1]}</Text>
        </Box>
      ))}
    </Box>
    {/* 第二行 2 卡 */}
    <Box style={{ flexDirection: 'row', gap: 18, height: 150 }}>
      {[
        ['稳定规模化交付能力', '2025 全年累计培训突破 6000 人次，交付体系成熟，可承接院校定向班、社会散客、全国机构批量内训。'],
        ['稀缺鉴定申报经验', '熟悉人社申报流程、场地标准、考评体系，具备协助民办院校申报技能等级鉴定资质完整落地经验。'],
      ].map((c, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '18px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
          <FAIcon name='star' style={{ fill: '#2E9E78', width: 28, height: 28 }} />
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46', marginTop: 8 }}>{c[0]}</Text>
          <Text style={{ fontSize: 15.5, color: '#3A463F', lineHeight: 1.5, marginTop: 6 }}>{c[1]}</Text>
        </Box>
      ))}
    </Box>
    {/* 行业短板对比条 */}
    <Box style={{ background: 'linear-gradient(135deg,#0A2B4D,#0F5C46)', borderRadius: 14, padding: '14px 22px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Text style={{ color: '#7FE3C0', fontSize: 17, fontWeight: 'bold', whiteSpace: 'nowrap' }}>行业普遍短板 → 叁竹补齐</Text>
      <Text style={{ color: 'rgba(255,255,255,0.92)', fontSize: 16, lineHeight: 1.5 }}>中小机构无课程 / 无场地 / 无全国渠道 / 无鉴定经验 / 无实体场景；叁竹合作后同时具备头部品牌、全套课程、线上平台、鉴定能力、医养配套，壁垒难以复制。</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>10 / 27</Text>
    </Box>
  </Box>
</Slide>
