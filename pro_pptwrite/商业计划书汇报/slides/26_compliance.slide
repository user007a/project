<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>合规管控与分阶段落地步骤</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 24 }}>
    {/* 左：四维合规 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F5C46' }}>（一）合规风险管控</Text>
      {[
        ['资产合规', '场地仅校内台账备案、不抵充出资，签书面无偿配套协议；协商定价过程纪要归档留存。'],
        ['股权财务合规', '独立对公账户，每季度出具财务报表供湖外查阅；大额支出股东协商，入股资金专款专用。'],
        ['办学鉴定合规', '培训考评严格遵循人社、教育标准，配合资质年审与现场核查。'],
        ['历史合作区分', '明确过往仅口头意向、无生效协议，全部权责以本次增资协议、补充协议、新章程为准。'],
      ].map((c, i) => (
        <Box key={i} style={{ background: '#FFFFFF', borderRadius: 12, padding: '12px 16px', boxShadow: '0 4px 14px rgba(15,92,70,0.08)', flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
          <FAIcon name='shield' style={{ fill: '#2E9E78', width: 24, height: 24, marginTop: 2 }} />
          <Box>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1C2B24' }}>{c[0]}</Text>
            <Text style={{ fontSize: 14.5, color: '#3A463F', lineHeight: 1.5 }}>{c[1]}</Text>
          </Box>
        </Box>
      ))}
    </Box>

    {/* 右：四阶段落地 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0A2B4D' }}>（二）分阶段落地步骤</Text>
      {[
        ['第一阶段', '1 个月内', '场地校内备案、院校内部审批；划定区域出平面图；估值纪要归档；叁竹股东会表决 1200 万方案。'],
        ['第二阶段', '1–2 个月', '签增资扩股协议、场地无偿配套协议及新章程；湖外首期 720 万实缴；工商变更，场地交付入驻。'],
        ['第三阶段', '同步推进', '以湖外为主体申报多工种省级鉴定资质；标准化考点改造；平台迭代；建立季度股东对账机制。'],
        ['第四阶段', '长期常态化', '省内网点全面落地，对外输出标准化康养培养模式，拓展全国机构咨询与业务布局。'],
      ].map((s, i) => (
        <Box key={i} style={{ background: '#FFFFFF', borderRadius: 12, padding: '12px 16px', boxShadow: '0 4px 14px rgba(15,92,70,0.08)', flex: 1, flexDirection: 'row', gap: 12, alignItems: 'center' }}>
          <Box style={{ width: 46, height: 46, borderRadius: 999, background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ color: '#FFFFFF', fontSize: 20, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>{i + 1}</Text>
          </Box>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 16.5, fontWeight: 'bold', color: '#0F5C46' }}>{s[0]} <Text style={{ color: '#5C6B63', fontWeight: 'normal', fontSize: 14 }}>· {s[1]}</Text></Text>
            <Text style={{ fontSize: 14, color: '#3A463F', lineHeight: 1.45, marginTop: 2 }}>{s[2]}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>26 / 27</Text>
    </Box>
  </Box>
</Slide>
