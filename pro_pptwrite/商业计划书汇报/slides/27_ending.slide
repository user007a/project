<Slide padding={0} style={{ width: '1280px', height: '720px', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  {/* 校园实景全屏背景 */}
  <Image src="assets/hero_gate.png" style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', objectFit: 'cover' }} />

  {/* 深绿半透明蒙版 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, background: 'linear-gradient(180deg, rgba(10,43,77,0.80) 0%, rgba(15,92,70,0.70) 60%, rgba(15,92,70,0.50) 100%)' }} />

  {/* 弧形 wave */}
  <Box style={{ position: 'absolute', left: 0, right: 0, bottom: 0, height: 260, overflow: 'hidden' }}>
    <svg width='1280' height='260' viewBox='0 0 1280 260' style={{ position: 'absolute', bottom: 0 }}>
      <path d='M0,120 C320,40 960,200 1280,90 L1280,260 L0,260 Z' fill='rgba(10,43,77,0.45)' />
      <path d='M0,170 C360,90 920,230 1280,140 L1280,260 L0,260 Z' fill='rgba(10,43,77,0.35)' />
    </svg>
  </Box>

  {/* 中央内容 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, justifyContent: 'center', alignItems: 'center' }}>
    <Box style={{ width: 96, height: 96, borderRadius: 999, background: 'rgba(255,255,255,0.15)', border: '3px solid rgba(255,255,255,0.35)', justifyContent: 'center', alignItems: 'center' }}>
      <FAIcon name='handshake' style={{ fill: '#7FE3C0', width: 48, height: 48 }} />
    </Box>
    <Text style={{ color: '#FFFFFF', fontSize: 52, fontWeight: 'bold', textAlign: 'center', marginTop: 30, textShadow: '0 4px 18px rgba(0,0,0,0.35)' }}>
      共建校园康养产业闭环
    </Text>
    <Box style={{ width: 120, height: 6, borderRadius: 3, background: '#2E9E78', marginVertical: 26 }} />
    <Text style={{ color: 'rgba(255,255,255,0.92)', fontSize: 26, textAlign: 'center', letterSpacing: 1 }}>
      共享产教融合长期价值 · 实现校企双向共赢
    </Text>
    <Text style={{ color: 'rgba(255,255,255,0.85)', fontSize: 22, marginTop: 36 }}>
      叁竹职业培训学校　×　湖南外国语职业学院
    </Text>
  </Box>

  <Text style={{ position: 'absolute', bottom: 48, left: 0, right: 0, textAlign: 'center', color: 'rgba(255,255,255,0.65)', fontSize: 15 }}>
    感谢聆听 · 期待携手共启康养产教融合新篇章
  </Text>
</Slide>
