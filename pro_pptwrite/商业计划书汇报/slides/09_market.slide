<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>行业政策与市场刚需</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 24 }}>
    {/* 左：政策红利 + 图表 */}
    <Box style={{ flex: 1.1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '16px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F5C46', marginBottom: 8 }}>政策红利</Text>
        <Text style={{ fontSize: 17, color: '#3A463F', lineHeight: 1.6 }}>· 长护险全国落地，多类照护工种强制持证上岗，考证可申领专项培训补贴。{'\n'}· 湖南省大力支持民办院校与培训机构开展混合所有制产教融合项目。</Text>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '14px 18px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flex: 1 }}>
        <Chart
          chartType='barChart'
          barDirection='bar'
          grouping='clustered'
          title='养老照护市场刚需（万人 / 亿）'
          titleColor='#1C2B24'
          showLegend={false}
          showDataLabels={true}
          dataLabelColor='#0F5C46'
          legendColor='#5C6B63'
          axisColor='#5C6B63'
          colors={['#0F5C46']}
          background='#FFFFFF'
          style={{ width: '100%', height: '100%' }}
          data={[
            ['指标', '规模'],
            ['60岁以上人口(亿)', 3.2],
            ['失能半失能(万)', 4500],
            ['持证人才缺口(万)', 900],
          ]}
        />
      </Box>
    </Box>

    {/* 右：市场空间洞察 + 判断 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', borderRadius: 14, padding: '20px 22px' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>市场空间</Text>
        <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.92)', lineHeight: 1.65, marginTop: 8 }}>
          全国 60 岁以上人口超 <Text style={{ color: '#7FE3C0', fontWeight: 'bold' }}>3.2 亿</Text>，失能半失能老人 <Text style={{ color: '#7FE3C0', fontWeight: 'bold' }}>4500 万</Text>，持证照护人才缺口超 <Text style={{ color: '#7FE3C0', fontWeight: 'bold' }}>900 万</Text>。
        </Text>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '20px 22px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flex: 1, justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F5C46', marginBottom: 8 }}>数据判断</Text>
        <Text style={{ fontSize: 17, color: '#3A463F', lineHeight: 1.65 }}>
          养老培训、省级技能鉴定、人才输送赛道持续高速增长；<Text style={{ fontWeight: 'bold', color: '#0F5C46' }}>省级鉴定机构审批名额稀缺</Text>，行业现金流稳定，先发卡位者尽享政策与人口双重红利。
        </Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>09 / 27</Text>
    </Box>
  </Box>
</Slide>
