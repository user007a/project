<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>工商变更后股权架构</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 24, alignItems: 'center' }}>
    {/* 左：环图 */}
    <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '16px 18px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', height: '100%', justifyContent: 'center' }}>
      <Chart
        chartType='doughnutChart'
        title='股权结构'
        titleColor='#1C2B24'
        showLegend={true}
        showDataLabels={true}
        legendColor='#5C6B63'
        dataLabelColor='#FFFFFF'
        colors={['#0F5C46', '#2E9E78']}
        background='#FFFFFF'
        style={{ width: '100%', height: '100%' }}
        data={[
          ['股东', '占比'],
          ['原自然人股东', 60],
          ['湖南外国语职业学院', 40],
        ]}
      />
    </Box>

    {/* 右：架构说明 + 估值逻辑 */}
    <Box style={{ flex: 1.2, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '16px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46', marginBottom: 6 }}>股东权责</Text>
        <Text style={{ fontSize: 16.5, color: '#3A463F', lineHeight: 1.6 }}>· <Text style={{ fontWeight: 'bold' }}>原自然人股东 60%</Text>：控股，统筹运营、市场、全国线上平台扩张与产业落地。{'\n'}· <Text style={{ fontWeight: 'bold' }}>湖南外国语职业学院 40%</Text>：全额现金出资，享分红权、重大经营事项监督权、场地联合使用权。</Text>
      </Box>
      <Box style={{ background: 'linear-gradient(135deg,#0A2B4D,#0F5C46)', borderRadius: 14, padding: '16px 20px', flex: 1, justifyContent: 'center' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', marginBottom: 6 }}>估值协商逻辑</Text>
        <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.92)', lineHeight: 1.62 }}>
          不聘第三方评估，依托长期合作基础、高层赛道研判、UBIC 全产业链战略，结合①省内前三品牌 + 6000+ 稳定现金流 ②九大工种自研课程（不可复制）③全国可复制线上平台 ④稀缺鉴定申报能力，综合协商<Text style={{ color:'#7FE3C0',fontWeight:'bold' }}>投前 3000 万元</Text>。划拨场地仅台账备案、不纳入作价。
        </Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>17 / 27</Text>
    </Box>
  </Box>
</Slide>
