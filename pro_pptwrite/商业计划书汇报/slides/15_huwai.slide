<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>湖外配套资源与合作价值</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 20 }}>
    {[
      ['assets/training_room.png', 'building', '（一）专属实训 + 办公场地', '新增明确约定，不纳入股权作价', '股权变更、签补充协议后，湖外一次性划定专属区域永久无偿交付：①标准化实训教学区（全套养老护理/评估/育婴实训室 + 人社鉴定标准设备）；②独立配套办公区（行政/招生/财务/考评团队）；场地仅校内台账备案、不抵充出资，合作全程免租金、免管理费，仅承担水电与耗材。'],
      ['assets/ubic_community.png', 'home', '（二）独有产业：UBIC 养老社区', '真实场景 + 定向就业 + 政策扶持', '宁平董事长重点规划板块，提供真实老年照护实景实训；结业学员优先入职，解决社区人力缺口；可申报省级嵌入式养老、产教融合专项扶持资金，完善康养产业闭环。'],
      ['assets/students_training.png', 'graduation-cap', '（三）软性赋能（无资金投入）', '生源 · 师资 · 资质 · 品牌', '稳定生源（医护专业在校生）、专业师资、申报主体资质（提升省级鉴定通过率）、院校品牌背书——便于对接民政、人社、医保官方项目。']
    ].map((c, i) => (
      <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, overflow: 'hidden', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
        <Box style={{ height: 170, overflow: 'hidden' }}>
          <Image src={c[0]} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
        </Box>
        <Box style={{ padding: '16px 18px 18px 18px', flex: 1, flexDirection: 'column' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
            <FAIcon name={c[1]} style={{ fill: '#0F5C46', width: 26, height: 26 }} />
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46' }}>{c[2]}</Text>
          </Box>
          <Box style={{ background: 'rgba(46,158,120,0.12)', borderRadius: 999, paddingVertical: 4, paddingHorizontal: 10, alignSelf: 'flex-start', marginBottom: 10 }}>
            <Text style={{ fontSize: 13, color: '#0F5C46', fontWeight: 'bold' }}>{c[3]}</Text>
          </Box>
          <Text style={{ fontSize: 15.5, color: '#3A463F', lineHeight: 1.6 }}>{c[4]}</Text>
        </Box>
      </Box>
    ))}
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>15 / 27</Text>
    </Box>
  </Box>
</Slide>
