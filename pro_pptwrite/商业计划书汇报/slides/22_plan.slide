<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>三年发展规划</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 130, left: 60, right: 60, bottom: 64, flexDirection: 'column', justifyContent: 'center' }}>
    {/* 时间轴连线 */}
    <Box style={{ position: 'absolute', left: 120, right: 120, top: 34, height: 4, background: 'linear-gradient(90deg,#0F5C46,#2E9E78)', borderRadius: 2 }} />
    <Box style={{ flexDirection: 'row', gap: 22, alignItems: 'flex-start' }}>
      {[
        ['第 1–2 年', '资质落地 · 场地标准化', '#0F5C46', ['完成标准化考点改造与多工种省级鉴定资质申报落地', '线上全国平台功能迭代，依托生源稳定年培训 6000+ 人次', '搭建省内各地市招生网点，第二年末实现整体盈亏平衡']],
        ['第 3 年', '省内规模化盈利', '#0A2B4D', ['养老机构批量内训业务全面铺开', '培训 / 鉴定 / 咨询 / 输送四大板块稳定盈利', '获评省级产教融合示范项目，申报专项扶持资金']],
        ['第 4–5 年', '全国平台复制扩张', '#2E9E78', ['对外输出"实训基地 + UBIC 社区 + 培训鉴定"标准化模式', '外省搭建合作分站，承接全国长护险城市批量订单', '公司股权价值持续提升']],
      ].map((s, i) => (
        <Box key={i} style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
          <Box style={{ width: 70, height: 70, borderRadius: 999, background: s[2], justifyContent: 'center', alignItems: 'center', border: '4px solid #F4F9F6', boxShadow: '0 4px 14px rgba(15,92,70,0.2)', zIndex: 1 }}>
            <Text style={{ color: '#FFFFFF', fontSize: 15, fontWeight: 'bold', textAlign: 'center', lineHeight: 1.2 }}>{s[0]}</Text>
          </Box>
          <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '16px 18px', marginTop: 18, boxShadow: '0 4px 16px rgba(15,92,70,0.08)', width: '100%', flex: 1 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: s[2], marginBottom: 8 }}>{s[1]}</Text>
            {s[3].map((p, j) => (
              <Box key={j} style={{ flexDirection: 'row', gap: 8, marginBottom: 7 }}>
                <Text style={{ color: s[2], fontSize: 15, fontWeight: 'bold', marginTop: 2 }}>·</Text>
                <Text style={{ fontSize: 15, color: '#3A463F', lineHeight: 1.5 }}>{p}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      ))}
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>22 / 27</Text>
    </Box>
  </Box>
</Slide>
