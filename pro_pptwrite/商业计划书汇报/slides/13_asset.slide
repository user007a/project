<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>资产结构与估值协商基础</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 22 }}>
    {/* 左：无形资产清单 + 条形图 */}
    <Box style={{ flex: 1.1, background: '#FFFFFF', borderRadius: 14, padding: '18px 22px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F5C46', marginBottom: 14 }}>核心高价值资产（均为无形资产）</Text>
      <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>
        {[
          ['九大工种课程著作权', 0.95],
          ['成熟技能鉴定申报运营体系', 0.88],
          ['省内头部品牌口碑与公信力', 0.82],
          ['全国线上招生咨询平台', 0.75],
          ['全国康养机构渠道网络', 0.70],
          ['稳定专业运营团队', 0.68],
        ].map((t, i) => (
          <Box key={i} style={{ flexDirection: 'column', gap: 5 }}>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
              <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <FAIcon name='diamond' style={{ fill: '#2E9E78', width: 18, height: 18 }} />
                <Text style={{ fontSize: 16, color: '#1C2B24' }}>{t[0]}</Text>
              </Box>
            </Box>
            <Box style={{ height: 10, background: '#EDF4F0', borderRadius: 5, overflow: 'hidden', marginLeft: 28 }}>
              <Box style={{ width: `${t[1] * 100}%`, height: '100%', background: i % 2 === 0 ? '#0F5C46' : '#2E9E78', borderRadius: 5 }} />
            </Box>
          </Box>
        ))}
      </Box>
    </Box>

    {/* 右：估值逻辑 + 大数字 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#FFFFFF', borderRadius: 14, padding: '18px 22px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flex: 1, justifyContent: 'center' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46', marginBottom: 8 }}>估值协商逻辑</Text>
        <Text style={{ fontSize: 16.5, color: '#3A463F', lineHeight: 1.62 }}>
          本次投前 <Text style={{ fontWeight: 'bold', color: '#0F5C46' }}>3000 万元估值不引入第三方资产评估</Text>，系双方基于多年合作信任、康养行业前景、湖外打造 UBIC 养老社区完整产业链的战略规划，结合叁竹现有业务规模与无形资产价值共同协商议定。合作后零场地租金，大幅优化盈利空间。
        </Text>
      </Box>
      <Box style={{ background: 'linear-gradient(135deg,#0A2B4D,#0F5C46)', borderRadius: 14, padding: '18px 24px', flexDirection: 'row', alignItems: 'center', gap: 18, height: 120 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
          <Text style={{ color: '#7FE3C0', fontSize: 56, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif", lineHeight: 1 }}>3000</Text>
          <Text style={{ color: '#FFFFFF', fontSize: 22, fontWeight: 'bold', marginBottom: 8, marginLeft: 6 }}>万元</Text>
        </Box>
        <Box style={{ width: 1, height: 60, background: 'rgba(255,255,255,0.25)' }} />
        <Text style={{ color: '#FFFFFF', fontSize: 16, lineHeight: 1.5 }}>投前公允估值{'\n'}<Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.75)' }}>（划拨场地仅台账备案，不纳入作价）</Text></Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>13 / 27</Text>
    </Box>
  </Box>
</Slide>
