<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>公司经营现状 · 股权与核心业务板块</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'column', gap: 16 }}>
    {/* 顶部数字条 */}
    <Box style={{ flexDirection: 'row', gap: 16, height: 96 }}>
      <Box style={{ flex: 1, background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', borderRadius: 14, padding: 14, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ color: '#FFFFFF', fontSize: 48, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>60%</Text>
        <Text style={{ color: 'rgba(255,255,255,0.9)', fontSize: 17 }}>原自然人股东{'\n'}持股并全权运营</Text>
      </Box>
      <Box style={{ flex: 1, background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', borderRadius: 14, padding: 14, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ color: '#FFFFFF', fontSize: 48, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>40%</Text>
        <Text style={{ color: 'rgba(255,255,255,0.9)', fontSize: 17 }}>湖外现金入股{'\n'}对应出资 1200 万</Text>
      </Box>
      <Box style={{ flex: 1, background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', borderRadius: 14, padding: 14, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ color: '#FFFFFF', fontSize: 48, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>6000+</Text>
        <Text style={{ color: 'rgba(255,255,255,0.9)', fontSize: 17 }}>2025 全年{'\n'}培训人次</Text>
      </Box>
    </Box>

    {/* 下排：左表 + 右图 */}
    <Box style={{ flex: 1, flexDirection: 'row', gap: 20 }}>
      {/* 左侧：业务板块表 */}
      <Box style={{ flex: 1.2, background: '#FFFFFF', borderRadius: 14, padding: '16px 18px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46', marginBottom: 10 }}>核心业务板块（五大方向）</Text>
        <Table
          style={{ width: '100%', height: '100%' }}
          defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1C2B24' }}
          defaultCellStyle={{ border: { left: { width: 1, color: '#E2EFE9' }, right: { width: 1, color: '#E2EFE9' }, top: { width: 1, color: '#E2EFE9' }, bottom: { width: 1, color: '#E2EFE9' } } }}
          cells={[
            [
              { text: '序号', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#0F5C46' } } },
              { text: '业务板块', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#0F5C46' } } },
            ],
            ['①', '线下标准化养老照护技能培训（省内前三，2025 年 6000+ 人次）'],
            [{ text: '②', cellStyle: { background: { color: '#F4F9F6' } } }, { text: '九大工种全套自研课程体系输出', cellStyle: { background: { color: '#F4F9F6' } } }],
            ['③', '全国线上招生、咨询数字化平台运营，全国拓客成熟'],
            [{ text: '④', cellStyle: { background: { color: '#F4F9F6' } } }, { text: '协助院校申报技能鉴定资质，联合申报省级认定', cellStyle: { background: { color: '#F4F9F6' } } }],
            ['⑤', '养老持证人才定向输送至养老院、长护险服务商'],
          ]}
        />
      </Box>

      {/* 右侧：经营指标柱状图 */}
      <Box style={{ flex: 0.85, background: '#FFFFFF', borderRadius: 14, padding: '16px 18px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F5C46', marginBottom: 14 }}>2025 核心经营指标</Text>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 22 }}>
          {[
            ['年培训人次', 6000, '#0F5C46', '6000+'],
            ['自研工种体系', 9, '#2E9E78', '9 大'],
            ['业务板块', 5, '#4AAD8C', '5 个'],
            ['覆盖范围', 1, '#0A2B4D', '全国'],
          ].map((row, i) => (
            <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
              <Text style={{ width: 90, fontSize: 14, color: '#3A463F', textAlign: 'right' }}>{row[0]}</Text>
              <Box style={{ flex: 1, height: 22, background: '#EDF4F0', borderRadius: 11, overflow: 'hidden' }}>
                <Box style={{ width: `${(row[1] / 6000) * 100}%`, minWidth: row[1] === 1 ? 40 : undefined, height: '100%', background: row[2], borderRadius: 11, justifyContent: 'center', paddingLeft: 10 }}>
                  <Text style={{ color: '#FFFFFF', fontSize: 13, fontWeight: 'bold' }}>{row[3]}</Text>
                </Box>
              </Box>
            </Box>
          ))}
        </Box>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>12 / 27</Text>
    </Box>
  </Box>
</Slide>
