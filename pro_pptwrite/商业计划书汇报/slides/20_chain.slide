<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>融合后全产业链业务布局</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'column', justifyContent: 'center', gap: 18 }}>
    <Text style={{ fontSize: 18, color: '#5C6B63', textAlign: 'center' }}>以"专属场地 + 院校资源 + 全国平台"为底座，构建培训—鉴定—平台—社区—输送—咨询完整闭环</Text>
    {/* 6 步闭环 */}
    <Box style={{ flexDirection: 'row', alignItems: 'stretch', justifyContent: 'center', gap: 6 }}>
      {[
        ['1', '双渠道培训', '线下专属实训教室 + 线上全国平台，申领人社培训补贴'],
        ['2', '省级技能鉴定', '湖外为申报主体，叁竹全流程运营，设标准化官方考点'],
        ['3', '线上平台扩张', '升级招生咨询系统，输出课程/培训/考证一体化'],
        ['4', 'UBIC 社区配套', '实景实训基地，学员优先入职，开展评估增值服务'],
        ['5', '人才定向输送', '结业学员输送至养老院、长护险服务商'],
        ['6', '机构咨询服务', '面向全国机构输出标准化模式，反哺营收'],
      ].map((n, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center' }}>
          <Box style={{ width: 172, background: '#FFFFFF', borderRadius: 12, padding: '14px 12px', boxShadow: '0 4px 14px rgba(15,92,70,0.08)', flexDirection: 'column', alignItems: 'center', borderTop: '4px solid #2E9E78' }}>
            <Box style={{ width: 34, height: 34, borderRadius: 999, background: i === 3 ? '#0A2B4D' : '#0F5C46', justifyContent: 'center', alignItems: 'center', marginBottom: 8 }}>
              <Text style={{ color: '#FFFFFF', fontSize: 18, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>{n[0]}</Text>
            </Box>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F5C46', textAlign: 'center' }}>{n[1]}</Text>
            <Text style={{ fontSize: 12.5, color: '#3A463F', lineHeight: 1.45, textAlign: 'center', marginTop: 6 }}>{n[2]}</Text>
          </Box>
          {i < 5 && (
            <Box style={{ width: 22, alignItems: 'center', justifyContent: 'center' }}>
              <FAIcon name='arrow-right' style={{ fill: '#2E9E78', width: 18, height: 18 }} />
            </Box>
          )}
        </Box>
      ))}
    </Box>
    <Box style={{ background: 'linear-gradient(90deg,#0F5C46,#0A2B4D)', borderRadius: 12, padding: '14px 24px', flexDirection: 'row', justifyContent: 'center', alignItems: 'center', gap: 12, marginTop: 6 }}>
      <FAIcon name='recycle' style={{ fill: '#7FE3C0', width: 24, height: 24 }} />
      <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>闭环反哺：社区与咨询收益回流培训与平台，形成自我强化的产教融合飞轮</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>20 / 27</Text>
    </Box>
  </Box>
</Slide>
