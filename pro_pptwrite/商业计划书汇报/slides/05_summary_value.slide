<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  {/* 顶部深绿数据通栏 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 92, background: '#0F5C46', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
      <Text style={{ color: 'rgba(255,255,255,0.85)', fontSize: 18 }}>投前估值</Text>
      <Text style={{ color: '#FFFFFF', fontSize: 38, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>3000</Text>
      <Text style={{ color: 'rgba(255,255,255,0.9)', fontSize: 20, fontWeight: 'bold' }}>万元</Text>
    </Box>
    <Box style={{ width: 1, height: 40, background: 'rgba(255,255,255,0.25)' }} />
    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
      <Text style={{ color: 'rgba(255,255,255,0.85)', fontSize: 18 }}>湖外出资</Text>
      <Text style={{ color: '#FFFFFF', fontSize: 38, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>1200</Text>
      <Text style={{ color: 'rgba(255,255,255,0.9)', fontSize: 20, fontWeight: 'bold' }}>万元</Text>
    </Box>
    <Box style={{ width: 1, height: 40, background: 'rgba(255,255,255,0.25)' }} />
    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
      <Text style={{ color: 'rgba(255,255,255,0.85)', fontSize: 18 }}>占股</Text>
      <Text style={{ color: '#FFFFFF', fontSize: 38, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>40</Text>
      <Text style={{ color: 'rgba(255,255,255,0.9)', fontSize: 20, fontWeight: 'bold' }}>%</Text>
    </Box>
    <Text style={{ color: 'rgba(255,255,255,0.7)', fontSize: 15 }}>协商定价体现信任 · 现金入股保障发展</Text>
  </Box>

  {/* 中部三列卡片 */}
  <Box style={{ position: 'absolute', top: 110, left: 60, right: 60, height: 348, flexDirection: 'row', gap: 20 }}>
    {[
      ['股权架构', [
        ['湖外全部以货币现金入股，持有公司', '40%', '股权'],
        ['原自然人股东持股', '60%', '并全权运营'],
        ['校方场地仅校内台账登记备案，', '不折价抵扣', '入股资金，合作后正式交付常态化使用']
      ]],
      ['估值逻辑', [
        ['不引入', '第三方资产评估', '机构'],
        ['依托双方多年合作积淀、湖外宁平董事长对康养行业的', '深度研判', ''],
        ['以打造校园 UBIC 养老社区', '全产业链闭环', '的长期战略目标协商确定']
      ]],
      ['资金投向', [
        ['01', '多工种省级鉴定资质申报'],
        ['02', '线上全国平台迭代'],
        ['03', '市场扩张'],
        ['04', '考评师资团队扩充']
      ]]
    ].map((col, idx) => (
      <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '18px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', flexDirection: 'column' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F5C46', marginBottom: 12, borderBottom: '2px solid #2E9E78', paddingBottom: 8 }}>{col[0]}</Text>
        {idx === 2 ? (
          <Box style={{ flex: 1, flexDirection: 'row', flexWrap: 'wrap', gap: 12 }}>
            {col[1].map((item, i) => (
              <Box key={i} style={{ width: '46%', background: '#F4F9F6', borderRadius: 10, padding: '14px 10px', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ color: '#0F5C46', fontSize: 18, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>{item[0]}</Text>
                <Text style={{ color: '#3A463F', fontSize: 15, marginTop: 6, textAlign: 'center' }}>{item[1]}</Text>
              </Box>
            ))}
          </Box>
        ) : (
          <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            {col[1].map((item, i) => (
              <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
                <Box style={{ width: 8, height: 8, borderRadius: 999, background: '#2E9E78', marginTop: 8 }} />
                <Text style={{ fontSize: 16, color: '#3A463F', lineHeight: 1.55, flex: 1 }}>
                  {item[0]}<Text style={{ color: '#0F5C46', fontWeight: 'bold' }}>{item[1]}</Text>{item[2]}
                </Text>
              </Box>
            ))}
          </Box>
        )}
      </Box>
    ))}
  </Box>

  {/* 底部六步闭环流程图 */}
  <Box style={{ position: 'absolute', bottom: 64, left: 60, right: 60, height: 152, background: '#FFFFFF', borderRadius: 14, padding: '16px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)' }}>
    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F5C46', marginBottom: 12 }}>完整产业闭环</Text>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      {[
        ['①', '湖外康养在校生'],
        ['②', '校内专属实训基地实操'],
        ['③', '省级技能鉴定发证'],
        ['④', '校内 UBIC 养老社区定向就业'],
        ['⑤', '全国养老机构人才输送'],
        ['⑥', '养老机构咨询服务'],
      ].map((s, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center' }}>
          <Box style={{ width: 138, height: 76, background: i === 3 ? '#0F5C46' : '#F4F9F6', borderRadius: 10, padding: 8, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ color: i === 3 ? '#7FE3C0' : '#2E9E78', fontSize: 16, fontWeight: 'bold', fontFamily: "'DIN Alternate','Inter',sans-serif" }}>{s[0]}</Text>
            <Text style={{ color: i === 3 ? '#FFFFFF' : '#1C2B24', fontSize: 14, textAlign: 'center', marginTop: 4, lineHeight: 1.35 }}>{s[1]}</Text>
          </Box>
          {i < 5 && (
            <Box style={{ width: 0, height: 0, borderTop: '8px solid transparent', borderBottom: '8px solid transparent', borderLeft: '12px solid #2E9E78', marginHorizontal: 6 }} />
          )}
        </Box>
      ))}
    </Box>
  </Box>

  {/* C 页脚 */}
  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>05 / 27</Text>
    </Box>
  </Box>
</Slide>
