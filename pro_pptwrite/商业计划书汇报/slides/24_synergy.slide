<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1C2B24' }}>双方协同价值与长期产业前景</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 124, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 20 }}>
    <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '18px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', borderTop: '4px solid #0F5C46', flexDirection: 'column' }}>
      <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F5C46', marginBottom: 10 }}>对湖外职业学院</Text>
      {[
        '破解传统外语专业瓶颈，打造高就业康养王牌专业，提升招生竞争力',
        '一次性盘活实训教室、办公用房与 UBIC 社区，转化为可持续盈利载体',
        '仅现金入股即共享省内头部培训 + 全国平台全部业务分红',
        '搭建"在校学习—技能考证—社区就业"闭环，树立产教融合标杆',
      ].map((t, i) => (
        <Box key={i} style={{ flexDirection: 'row', gap: 8, marginBottom: 9 }}>
          <Text style={{ color: '#0F5C46', fontSize: 15, fontWeight: 'bold', marginTop: 2 }}>✓</Text>
          <Text style={{ fontSize: 15.5, color: '#3A463F', lineHeight: 1.5 }}>{t}</Text>
        </Box>
      ))}
    </Box>

    <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '18px 20px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)', borderTop: '4px solid #2E9E78', flexDirection: 'column' }}>
      <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#2E9E78', marginBottom: 10 }}>对叁竹培训学校</Text>
      {[
        '长期稳定获得专属实训教学区 + 独立办公区，零租金使用',
        '绑定院校生源、品牌与鉴定申报主体资质，降低获客与申报难度',
        'UBIC 养老社区提供独家实景实训场景，巩固省内前三领先地位',
        '借院校渠道对接政府项目，叠加自有全国平台双向发力加速布局',
      ].map((t, i) => (
        <Box key={i} style={{ flexDirection: 'row', gap: 8, marginBottom: 9 }}>
          <Text style={{ color: '#2E9E78', fontSize: 15, fontWeight: 'bold', marginTop: 2 }}>✓</Text>
          <Text style={{ fontSize: 15.5, color: '#3A463F', lineHeight: 1.5 }}>{t}</Text>
        </Box>
      ))}
    </Box>

    <Box style={{ flex: 1.15, background: 'linear-gradient(135deg,#0A2B4D,#0F5C46)', borderRadius: 14, padding: '18px 20px', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#7FE3C0', marginBottom: 10 }}>长期产业前景</Text>
      <Text style={{ fontSize: 15.5, color: 'rgba(255,255,255,0.94)', lineHeight: 1.62 }}>
        人口老龄化与长护险全国落地构成<Text style={{ color:'#7FE3C0',fontWeight:'bold' }}>二十年长期驱动</Text>，持证人才刚需长存；AI 冲击下民办院校康养转型不可逆。{'\n\n'}本次合作以现金入股 + 场地永久免费使用的轻量化模式，构建独家"院校实训基地 + 校园嵌入式养老 + 线下培训 + 全国平台 + 技能鉴定"完整闭环，兼具政策合规、盈利稳定与长期股权增值空间。
      </Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>24 / 27</Text>
    </Box>
  </Box>
</Slide>
