<Slide padding={0} style={{ background: '#F4F9F6', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  {/* A 标题块 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 110, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#0F5C46', borderRadius: 3, marginRight: 18 }} />
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1C2B24' }}>报告纲要</Text>
    <Box style={{ flex: 1, height: 1, background: '#D9E8E1', marginLeft: 24 }} />
    <Text style={{ fontSize: 16, color: '#5C6B63', marginLeft: 16 }}>CONTENTS</Text>
  </Box>

  {/* B 内容区：两列卡片 */}
  <Box style={{ position: 'absolute', top: 130, left: 60, right: 60, bottom: 64, flexDirection: 'row', gap: 28 }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      {[
        ['01', '执行摘要', '合作根基 · 核心突破 · 估值与收益'],
        ['02', '校企合作渊源与合作动因', '长期合作历史与双方转型诉求'],
        ['03', '养老照护行业市场与核心优势', '政策红利 · 市场空间 · 五维优势'],
        ['04', '叁竹公司经营现状与平台价值', '股权业务 · 无形资产 · 估值基础'],
        ['05', '湖外配套资源与合作价值', '专属场地 · UBIC 社区 · 软性赋能'],
      ].map((c, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#FFFFFF', borderRadius: 14, padding: '16px 22px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)' }}>
          <Box style={{ width: 52, height: 52, borderRadius: 12, background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ color: '#FFFFFF', fontSize: 24, fontWeight: 'bold' }}>{c[0]}</Text>
          </Box>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1C2B24' }}>{c[1]}</Text>
            <Text style={{ fontSize: 15, color: '#5C6B63', marginTop: 3 }}>{c[2]}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      {[
        ['06', '股权架构、估值与现金入股', '3000万估值 · 1200万出资 · 40%股权'],
        ['07', '融合后全产业链业务布局', '培训 · 鉴定 · 平台 · 社区闭环'],
        ['08', '三年发展规划', '资质落地 · 省内盈利 · 全国复制'],
        ['09', '双方协同价值与产业前景', '对湖外 · 对叁竹 · 长期前景'],
        ['10', '合规管控与落地实施步骤', '四维合规 · 四阶段落地'],
      ].map((c, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#FFFFFF', borderRadius: 14, padding: '16px 22px', boxShadow: '0 4px 16px rgba(15,92,70,0.08)' }}>
          <Box style={{ width: 52, height: 52, borderRadius: 12, background: 'linear-gradient(135deg,#0F5C46,#0A2B4D)', justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ color: '#FFFFFF', fontSize: 24, fontWeight: 'bold' }}>{c[0]}</Text>
          </Box>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1C2B24' }}>{c[1]}</Text>
            <Text style={{ fontSize: 15, color: '#5C6B63', marginTop: 3 }}>{c[2]}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>

  {/* C 页脚 */}
  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 58, paddingLeft: 60, paddingRight: 60, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 14, color: '#5C6B63', textAlign: 'center' }}>叁竹 × 湖外 校企合作商业计划书</Text>
    <Box style={{ flex: 1, alignItems: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#5C6B63' }}>02 / 27</Text>
    </Box>
  </Box>
</Slide>
