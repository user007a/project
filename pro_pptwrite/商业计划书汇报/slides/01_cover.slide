<Slide padding={0} style={{ width: '1280px', height: '720px', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
  {/* 校园实景全屏背景 */}
  <Image src="assets/hero_gate.png" style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', objectFit: 'cover' }} />

  {/* 深绿半透明蒙版 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, background: 'linear-gradient(180deg, rgba(10,43,77,0.78) 0%, rgba(15,92,70,0.72) 55%, rgba(15,92,70,0.55) 100%)' }} />

  {/* 顶部日期 */}
  <Text style={{ position: 'absolute', top: 54, left: 0, right: 0, textAlign: 'center', color: 'rgba(255,255,255,0.9)', fontSize: 20, letterSpacing: 4 }}>
    2026 / 08 / 16
  </Text>

  {/* 主标题区 */}
  <Box style={{ position: 'absolute', top: 186, left: 0, right: 0, alignItems: 'center' }}>
    <Text style={{ color: '#FFFFFF', fontSize: 64, fontWeight: 'bold', textShadow: '0 4px 20px rgba(0,0,0,0.35)', letterSpacing: 2 }}>
      校企合作商业计划书
    </Text>
    <Box style={{ width: 120, height: 6, borderRadius: 3, background: '#2E9E78', marginTop: 24 }} />
    <Text style={{ color: 'rgba(255,255,255,0.95)', fontSize: 28, marginTop: 24, letterSpacing: 2 }}>
      叁竹职业培训学校 × 湖南外国语职业学院
    </Text>
  </Box>

  {/* 底部海军蓝弧形 wave + 白色区域 */}
  <Box style={{ position: 'absolute', left: 0, right: 0, bottom: 0, height: 240, overflow: 'hidden' }}>
    <svg width='1280' height='240' viewBox='0 0 1280 240' style={{ position: 'absolute', bottom: 0 }}>
      <path d='M0,540 C320,500 960,580 1280,520 L1280,720 L0,720 Z' fill='#F8FBFA' transform='translate(0,-480)' />
      <path d='M0,500 C320,460 960,540 1280,480 L1280,525 C960,565 320,485 0,525 Z' fill='#0A2B4D' />
    </svg>

    {/* 校徽/Logo 徽章 */}
    <Box style={{ position: 'absolute', left: 0, right: 0, top: 18, alignItems: 'center' }}>
      <Box style={{ width: 86, height: 86, borderRadius: 999, background: '#FFFFFF', border: '3px solid #0A2B4D', justifyContent: 'center', alignItems: 'center', boxShadow: '0 4px 16px rgba(0,0,0,0.15)' }}>
        <FAIcon name='graduation-cap' style={{ fill: '#0F5C46', width: 44, height: 44 }} />
      </Box>
    </Box>
  </Box>

  {/* 标的摘要条 */}
  <Box style={{ position: 'absolute', bottom: 136, left: 60, right: 60, flexDirection: 'row', justifyContent: 'center', gap: 24 }}>
    {[
      ['标的主体', '长沙市望城区叁竹职业培训学校有限公司'],
      ['合作模式', '湖外现金入股持股 40% · 原股东 60%'],
      ['核心赛道', '养老照护九大工种 + 省级技能认定'],
    ].map((item, i) => (
      <Box key={i} style={{ background: 'rgba(255,255,255,0.12)', border: '1px solid rgba(255,255,255,0.22)', borderRadius: 12, padding: '14px 20px', minWidth: 300 }}>
        <Text style={{ color: '#7FE3C0', fontSize: 15, fontWeight: 'bold' }}>{item[0]}</Text>
        <Text style={{ color: '#FFFFFF', fontSize: 16, marginTop: 5, lineHeight: 1.4 }}>{item[1]}</Text>
      </Box>
    ))}
  </Box>

  {/* 汇报人 */}
  <Text style={{ position: 'absolute', bottom: 56, left: 0, right: 0, textAlign: 'center', color: '#5C6B63', fontSize: 16 }}>
    呈报：双方战略合作决策委员会
  </Text>
</Slide>
